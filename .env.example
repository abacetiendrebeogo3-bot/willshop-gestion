# Supabase Public & Anon Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WillShop Initial Seed Admin
INITIAL_ADMIN_EMAIL=admin@willshop.bf

# Anthropic Claude AI Credentials (SERVER SIDE ONLY - NEVER EXPOSE TO CLIENT)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# Evolution API (WhatsApp Gateway) — SERVER SIDE ONLY
EVOLUTION_API_URL=https://your-evolution-server.example.com
EVOLUTION_API_KEY=your-evolution-api-key-here

# URL publique de l'app, utilisée pour construire l'URL de webhook envoyée à Evolution API
NEXT_PUBLIC_APP_URL=https://willshop-gestion.vercel.app

# Token de vérification pour le webhook Meta/WhatsApp (GET de validation)
WHATSAPP_VERIFY_TOKEN=un-secret-que-tu-choisis-toi-meme
